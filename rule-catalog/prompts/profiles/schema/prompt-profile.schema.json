{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fdai.dev/schemas/rule-catalog/prompt-profile/1.0.0",
  "title": "Prompt Profile Catalog",
  "type": "object",
  "required": ["schema_version", "profiles"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "capability_id",
          "mode",
          "root",
          "packs",
          "system_token_budget",
          "request_token_budget",
          "reserved_output_tokens",
          "promotion_evidence",
          "provenance"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.\\-]*$"},
          "version": {"type": "integer", "minimum": 1},
          "capability_id": {"type": "string", "minLength": 1},
          "mode": {"enum": ["active", "shadow"]},
          "root": {"$ref": "#/$defs/artifact_ref"},
          "packs": {
            "type": "array",
            "items": {"$ref": "#/$defs/artifact_ref"}
          },
          "system_token_budget": {"type": "integer", "minimum": 1},
          "request_token_budget": {"type": "integer", "minimum": 2},
          "reserved_output_tokens": {"type": "integer", "minimum": 1},
          "promotion_evidence": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "provenance": {
            "type": "object",
            "required": ["source"],
            "additionalProperties": false,
            "properties": {
              "source": {"type": "string", "minLength": 1},
              "notes": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "$defs": {
    "artifact_ref": {
      "type": "object",
      "required": ["id", "version", "layer"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.\\-]*$"},
        "version": {"type": "integer", "minimum": 1},
        "layer": {
          "enum": ["base", "pack", "critic", "judge", "rubric", "role-header"]
        }
      }
    }
  }
}
