  },
  "nodes": [
    {
      "id": "huginn",
      "kind": "process",
      "shape": "card",
      "label": {
        "en": "Huginn / discovers changes",
        "ko": "Huginn / 변경 탐색"
      },
      "description": {
        "en": "Collects and normalizes the resource change without deciding or executing.",
        "ko": "판단하거나 실행하지 않고 리소스 변경을 수집하고 정규화합니다."
      }
    },
    {
      "id": "heimdall",
      "kind": "process",
      "shape": "card",
      "label": {
        "en": "Heimdall / checks coverage",
        "ko": "Heimdall / 근거 범위 확인"
      },
      "description": {
        "en": "Checks freshness and coverage before a decision can use the evidence.",
        "ko": "결정에서 근거를 사용하기 전에 최신성과 범위를 확인합니다."
      }
    },
    {
      "id": "forseti",
      "kind": "process",
      "shape": "card",
      "label": {
        "en": "Forseti / decides",
        "ko": "Forseti / 판정"
      },
      "description": {
        "en": "Owns the decision and never executes it.",
        "ko": "결정을 소유하며 직접 실행하지 않습니다."
      }
    },
    {
      "id": "njord",
      "kind": "process",
      "label": {
        "en": "Njord",
        "ko": "Njord"
      },
      "description": {
        "en": "Advises on cost.",
        "ko": "비용 관점에서 자문합니다."
      }
    },
    {
      "id": "freyr",
      "kind": "process",
      "label": {
        "en": "Freyr",
        "ko": "Freyr"
      },
      "description": {
        "en": "Advises on capacity.",
        "ko": "용량 관점에서 자문합니다."
      }
    },
    {
      "id": "loki",
      "kind": "process",
      "label": {
        "en": "Loki",
        "ko": "Loki"
      },
      "description": {
        "en": "Advises on bounded chaos and recovery evidence.",
        "ko": "범위가 제한된 카오스와 복구 근거를 자문합니다."
      }
    },
    {
      "id": "odin",
      "kind": "process",
      "shape": "card",
      "label": {
        "en": "Odin / arbitrates conflicts",
        "ko": "Odin / 충돌 중재"
      },
      "description": {
        "en": "Orders eligible options only when objectives conflict.",
        "ko": "목표가 충돌할 때만 실행 가능한 선택지의 순서를 정합니다."
      }
    },
    {
      "id": "thor",
      "kind": "process",
      "shape": "card",
      "label": {
        "en": "Thor / executes",
        "ko": "Thor / 실행"
      },
      "description": {
        "en": "Dispatches only an eligible decision.",
        "ko": "실행 가능한 결정만 전달합니다."
      }
    },
    {
      "id": "var",
      "kind": "process",
      "shape": "card",
      "label": {
        "en": "Var / carries approval",
        "ko": "Var / 승인 전달"
      },
      "description": {
        "en": "Carries a distinct human decision and cannot execute it.",
        "ko": "별도의 사람 결정을 전달하며 직접 실행할 수 없습니다."
      }
    },
    {
      "id": "vidar",
      "kind": "process",
      "shape": "card",
      "label": {
        "en": "Vidar / recovery",
        "ko": "Vidar / 복구"
      },
      "description": {
        "en": "Owns required rollback, failover, or state-forward recovery.",
        "ko": "필요한 롤백, 장애 조치 또는 상태 전진 복구를 소유합니다."
      }
    },
    {
      "id": "saga",
      "kind": "process",
      "shape": "card",
      "label": {
        "en": "Saga / audits",
        "ko": "Saga / 감사"
      },
      "description": {
        "en": "Records every terminal outcome, including denied no-ops.",
        "ko": "거부된 미실행을 포함한 모든 최종 결과를 기록합니다."
      }
    },
    {
      "id": "norns",
      "kind": "process",
      "shape": "card",
      "label": {
        "en": "Norns / proposes candidate",
        "ko": "Norns / 후보 제안"
      },
      "description": {
        "en": "Proposes an inert candidate without promoting or executing it.",
        "ko": "승격하거나 실행하지 않고 비활성 후보를 제안합니다."
      }
    }
  ],
